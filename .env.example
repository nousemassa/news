#: Образец окружения проекта `news`: копируется в `.env` рядом с композом — и этот файл ОБЯЗАТЕЛЕН.
#: Общий `.env` воркспейса, если он есть, подключается ПЕРВЫМ (для подстановки `${…}` в композе):
#: значения проекта его перекрывают. В контейнер идёт ТОЛЬКО этот файл — всё нужное должно быть здесь.
#: ❗ СВОЯ база проекта — `news`: адрес живёт здесь, а не в общем окружении.
DB_URL=postgresql+asyncpg://news:CHANGE_ME@news-db:5432/news
#: Пароль своего экземпляра postgres: его читает композ, создавая контейнер базы.
NEWS_DB_PASSWORD=CHANGE_ME
#: ❗ Имя общей сети платформы (`external: true`): в ней живут база, эмбеддинги и мост. Обязательно —
#: умолчания в композе нет, а с умолчанием подключение ушло бы в случайно совпавшую сеть.
#: Имя общей сети. В воркспейсе его задаёт ОБЩАЯ ОСНОВА (там же, где адрес платформы);
#: раскомментируйте и задайте своё, если проект стоит отдельным клоном.
# PLATFORM_NETWORK=platform-net
#: Пароль векторной базы: её владелец — проект `realty`, адрес и пароль берутся из его окружения.
#: Здесь — только для проверки разбора композа; в бою значение приходит из общего окружения.
VECTOR_DB_PASSWORD=CHANGE_ME
#: Режим платформы: кто исполняет ход агента. Значение — из `lib/vendors.tsv`; пусто ⇒ вендор по
#: умолчанию из таблицы (первый со способностью `runtime`).
#: Ось НАБЛЮДАЕМОСТИ отдельно от оси рантайма; пусто ⇒ берётся `PLATFORM_VENDOR`.
TEAM_PRICE_IN_PER_1K_USD=0
TEAM_PRICE_OUT_PER_1K_USD=0
TEAM_MCP_SERVERS=searxng=http://mcp-searxng:3000/mcp
TEAM_MCP_SERVERS_HOST=searxng=http://127.0.0.1:3001/mcp
AGENT_BOT_NEWS=news-hunter              # slug канального агента новостей
NEWS_WORKFLOW_ID=                 # workflow агента новостей (создаётся в платформе)
NEWS_REVISION_ID=                 # ревизия с mcps: [{connection: {type: gateway, namespace: custom, slug: searxng}}]
NEWS_CONNECTION_SLUG=news-hunter-conn

# --- Telegram: доступ и адресаты ---
#: MTProto (my.telegram.org): без пары api_id/api_hash бот не подключается и /health покажет telegram=false.
#: Токен бота и рабочий канал публикации; пустой токен ⇒ бот выключен, процесс жив и /health отвечает.
TELEGRAM_NEWS_BOT_TOKEN=
TELEGRAM_NEWS_CHANNEL_ID=
#: Кому слать карточки: свой чат новостей, иначе общий `TELEGRAM_OWNER_CHAT_ID`.
TELEGRAM_NEWS_OWNER_CHAT_ID=
#: Подпись кнопок «Редактировать»/«Опубликовать»: короче 16 символов — кнопки не рендерятся.

# --- Адреса сервисов моделей (объявляет агент) ---
#: В бою службы могут стоять на разных хостах: адрес берётся отсюда и нигде не зашивается.
LLAMA_EMBED_URL=http://embed:8082/v1
LLAMA_EMBED_URL_HOST=http://127.0.0.1:8082/v1
LLAMA_EMBED_API_KEY=
LLAMA_EMBED_MODEL=embeddinggemma-2
LLAMA_EMBED_TIMEOUT_S=15
SOLVER_URL=http://solver:8083
SOLVER_URL_HOST=http://127.0.0.1:8083
SOLVER_API_KEY=
SOLVER_TIMEOUT_S=60

# --- Приём телеметрии (адрес; вендор приёма — ось TELEMETRY_VENDOR) ---

#: ❗ Ключи с двумя потребителями (платформа, Telegram-доступ, LLM, OTLP, общая сеть, пароль
#: векторной базы) живут в ОБЩЕЙ ОСНОВЕ воркспейса — здесь их нет намеренно: пустое значение
#: в этом файле перекрыло бы основу (env_file читается в порядке «основа → проект»).
